;; =====================================
;; Combos
;; =====================================

(defvar
  cmb-ms 50
)

(defchordsv2
  (1 4) f19 $cmb-ms all-released ()
  (1 2) f20 $cmb-ms all-released ()
  (3 4) f21 $cmb-ms all-released ()
  (1 3) f22 $cmb-ms all-released ()
  (2 4) f23 $cmb-ms all-released ()
  (2 3) f24 $cmb-ms all-released ()

  (w e) q $cmb-ms all-released ()
  (i o) p $cmb-ms all-released ()

  (s d) del $cmb-ms all-released ()
  (s f) tab $cmb-ms all-released ()

  (j k) (macro mhnk esc) $cmb-ms all-released ()
  (, .) (unicode _) $cmb-ms all-released ()
  (i l) . $cmb-ms all-released ()

  (d c) mhnk $cmb-ms all-released ()
  (k m) hnk $cmb-ms all-released ()

  (a z) (macro e x i t) $cmb-ms all-released ()
)
