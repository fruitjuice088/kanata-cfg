;; =====================================
;; Combos
;; =====================================

(defvar
  cmb-ms 50
)

(defchordsv2
  (1 3) f18 $cmb-ms all-released ()
  (2 4) f19 $cmb-ms all-released ()
  (2 3) f20 $cmb-ms all-released ()
  (1 4) f21 $cmb-ms all-released ()
  (1 2) f22 $cmb-ms all-released ()
  (3 4) f23 $cmb-ms all-released ()

  (s f) tab $cmb-ms all-released ()

  (j k) (macro mhnk esc) $cmb-ms all-released ()
  (, .) (unicode _) $cmb-ms all-released ()
  (j l) return $cmb-ms all-released ()

  (a z) (macro e x i t) $cmb-ms all-released ()
)
