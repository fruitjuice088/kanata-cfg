;; =====================================
;; Kanata Main Configuration
;; =====================================

(include config.kbd)

(defsrc
       1    2    3    4    5     6    7    8    9    0  -  apo
  tab   q    w    e    r    t     y    u    i    o    p
  rctl   a    s    d    f    g     h    j    k    l   eql scln
  lsft    z    x    c    v    b     n    m    ,    .    /
  lctl    lmet lalt mhnk     spc       hnk
)

(defalias
  lopt (tap-hold-release $tap-time $hold-time f24  lctl)
  sands (tap-hold-release $tap-time $hold-time spc lsft)
)

(include combos.kbd)

(deflayer base
       _    _    _    _    _     _    _    _    _    _   _   _
  _     _    _    _    _    _     _    _    _    _    _
  _      _    _    _    _    _     _    _    _    _    _   _
  _       _    _    _    _    _     _    _    _    _    _
  @lopt   _    _    _      @sands        _
)
