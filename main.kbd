;; =====================================
;; Kanata Main Configuration
;; =====================================

(include config.kbd)

(defsrc
  tab   q    w    e    r    t     y    u    i    o    p
  caps   a    s    d    f    g     h    j    k    l
  lsft    z    x    c    v    b     n    m    ,    .    /
                   mhnk      spc        hnk
)

(defalias
  ;; layers
  pad (layer-while-held pad)

  tpad (tap-hold $tap-time $hold-time tab @pad)

  sft_spc (tap-hold-press $tap-time $hold-time spc lsft)

  ;; Home Row Mods
  hd (tap-hold-release $tap-time $hold-time d lctl)
  hf (tap-hold-release $tap-time $hold-time f lalt)
  hj (tap-hold-release $tap-time $hold-time j ralt)
  hk (tap-hold         $tap-time $hold-time k rctl)
)

(include combos.kbd)

(deflayer base
  @tpad _    _    _    _    _     _    _    _    _    _
  _      _    _  @hd   @hf   _     _   @hj  @hk   _
  _       _    _    _    _    _     _    _    _    _    _
                   bspc    @sft_spc     ret
)

(deflayer pad
  XX    _    _    _    _    _    pgup  _    _    _    _
  _      _    _    _    _    _    left down  up  rght
  _       _    _    _    _    _    pgdn home  _   end   _
                    _         _          _
)
